# Agentic AI Environment Variables
# Copy this file to .env and fill in your actual API keys
# IMPORTANT: Never commit your .env file to git!

# === LLM Providers (choose one or more) ===

# Google Gemini (Recommended for this course)
GOOGLE_API_KEY=your_gemini_api_key_here
# Get your key from: https://aistudio.google.com/app/apikey

# OpenAI (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# Get your key from: https://platform.openai.com/api-keys

# Ollama (Local models)
# OLLAMA_BASE_URL=http://localhost:11434
# Install Ollama from: https://ollama.ai/

# === Database & Backend Services ===

# Supabase Configuration (Required)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_role_key
# Get these from: https://app.supabase.com/project/_/settings/api

# PostgreSQL Database Connection (Optional - for flashcard agent state persistence)
# This enables persistent checkpointing for flashcard generation tasks.
# If not set, the system will fall back to MemorySaver (state lost on restart).
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Get this from: https://app.supabase.com/project/_/settings/database
# Look for "Connection string" under "Connection pooling" or "Direct connection"
# Use the "URI" format, or construct it manually using your database password
# DATABASE_URL=postgresql://postgres:your_database_password@db.your_project_ref.supabase.co:5432/postgres

# === Observability (Optional) ===

# Langfuse for LLM observability and prompt management
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# LANGFUSE_ENABLED=false
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Get your keys from: https://cloud.langfuse.com/settings

# === Tool APIs (Optional) ===

# Tavily Search (for web search tool)
# TAVILY_API_KEY=your_tavily_api_key_here
# Get your key from: https://tavily.com/

# OpenWeatherMap (for weather tool)
# OPENWEATHER_API_KEY=your_openweather_api_key_here
# Get your key from: https://openweathermap.org/api

# === Configuration ===

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Default LLM provider
DEFAULT_LLM_PROVIDER=gemini

# Default temperature for LLM responses
DEFAULT_TEMPERATURE=0.7

# === Text-to-Speech (TTS) Configuration ===
# Google Cloud TTS for Chinese language learning flashcards
# This is OPTIONAL - the app will work without it, but TTS features won't be available

# Path to Google Cloud service account JSON file
# For team setup: Place the shared JSON file in backend/credentials/ and use relative path
# For individual setup: Create your own service account and download the JSON file
# Example (relative path): GOOGLE_APPLICATION_CREDENTIALS=backend/credentials/google-cloud-tts-key.json
# Example (absolute path): GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: Google Cloud Project ID
# GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Optional: TTS Language Code (default: zh-CN for Chinese)
# TTS_LANGUAGE_CODE=zh-CN

# Optional: TTS Voice Name (leave empty to use Google's default)
# Common voices: zh-CN-Wavenet-C (female), zh-CN-Wavenet-D (male)
# TTS_VOICE_NAME=zh-CN-Wavenet-C

# Optional: TTS Speaking Rate (0.25 to 4.0, default: 1.0)
# Lower values = slower speech, higher values = faster speech
# TTS_SPEAKING_RATE=1.0

# === Setup Instructions ===
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual API keys and configuration
# 3. For TTS setup, see: backend/credentials/README.md
