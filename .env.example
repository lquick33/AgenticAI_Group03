# Agentic AI Environment Variables
# Copy this file to .env for backend/runtime settings.
# Frontend client variables live in frontend/.env.example.

# === Backend Core ===
GOOGLE_API_KEY=your_gemini_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Optional alternative model provider
# OPENAI_API_KEY=your_openai_api_key_here

# Background jobs / workers
# REDIS_URL=redis://localhost:6379/0

# Production-safe defaults
DEBUG=false
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
BACKEND_CORS_ORIGIN_REGEX=https://.*\.vercel\.app$

# Langfuse observability (optional)
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# LANGFUSE_ENABLED=false
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Text-to-Speech (optional)
GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_PROJECT_ID=your-project-id
# TTS_LANGUAGE_CODE=zh-CN
# TTS_VOICE_NAME=zh-CN-Wavenet-C
# TTS_SPEAKING_RATE=1.0

# Deployment notes
# - Frontend staging/prod vars: see frontend/.env.example
# - For Railway/Render, set DEBUG=false explicitly.
# - For Vercel previews, BACKEND_CORS_ORIGIN_REGEX covers *.vercel.app.
